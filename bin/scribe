#!/bin/bash
# scribe: the Terminal Scribe helper for Claude Code.
#
# Claude runs these commands on the user's behalf, and the plugin's hooks call
# `scribe hook ...`. The plugin puts this bin/ directory on the Bash tool's PATH.
# Written for bash 3.2+ so it runs on a stock Mac.

set -u

# Where this script and the plugin live.
SCRIBE_BIN_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIBE_BIN_PATH")/.." && pwd)"
TEMPLATES="$PLUGIN_ROOT/templates"

# Per-user data that must outlive plugin updates and uninstalls.
SCRIBE_HOME="${SCRIBE_HOME:-$HOME/.scribe}"
LIBRARY="$SCRIBE_HOME/library"
CONFIG="$SCRIBE_HOME/config"
DECLINED="$SCRIBE_HOME/declined"
GLOBAL_LOG="$SCRIBE_HOME/scribe.log"
REGISTRY="$SCRIBE_HOME/projects.tsv"
SESSIONS="$SCRIBE_HOME/sessions"

# Set per project by set_project; these are the defaults.
JOURNAL_NAME=".scribe"
LESSONS="lessons.md"

# shellcheck source=../lib/common.sh
. "$PLUGIN_ROOT/lib/common.sh"
# shellcheck source=../lib/journal.sh
. "$PLUGIN_ROOT/lib/journal.sh"
# shellcheck source=../lib/projects.sh
. "$PLUGIN_ROOT/lib/projects.sh"
# shellcheck source=../lib/hooks.sh
. "$PLUGIN_ROOT/lib/hooks.sh"

usage() {
  cat <<EOF
scribe $(plugin_version): the Terminal Scribe helper.

Claude runs these for you when you ask in plain English.

Projects
  scribe new NAME [--about TEXT]   Start a project in your projects folder
  scribe open NAME           Open a project and print its journal
  scribe list [--all]        List projects, most recent first
  scribe rename OLD NEW      Rename a project and its folder
  scribe close | reopen NAME Close a project (with a final archive) or reopen it
  scribe adopt [FOLDER]      Add an existing folder to the project list
  scribe import-kit          Add every project from the earlier project kit
  scribe running | stop NAME Which projects are running; stop one
  scribe search WORDS        Search every project's journal
  scribe digest [DAYS]       What happened across projects lately
  scribe preship             Checks before pushing code
  scribe publish [--public]  Create a GitHub repository and push

Journal
  scribe init [--decline]    Turn journaling on here (or say no, once)
  scribe status              Is journaling on, and what is in the journal
  scribe pause | resume      Stop and restart journal writes
  scribe curate              Tidy and reorganise the journal now
  scribe archive             Save a summary of the project to your desktop
  scribe library             List archived projects
  scribe link | unlink NAME  Load (or stop loading) an archived project's lessons
  scribe off [--yes]         Turn journaling off here and delete the journal
  scribe config [KEY VALUE]  Settings: background on|off, model NAME|default
  scribe migrate             Move a journal from the old journal/ folder
  scribe remove-old-install  Remove the old curl-installed version
  scribe doctor              Check that everything is set up
  scribe version             Print the version
EOF
}

main() {
  [ $# -gt 0 ] || { usage; exit 1; }
  local cmd="$1"
  shift
  case "$cmd" in
    new)                cmd_new "$@" ;;
    open)               cmd_open "$@" ;;
    list|projects)      cmd_list "$@" ;;
    rename)             cmd_rename "$@" ;;
    close)              cmd_close "$@" ;;
    reopen)             cmd_reopen "$@" ;;
    adopt)              cmd_adopt "$@" ;;
    import-kit)         cmd_import_kit "$@" ;;
    running)            cmd_running "$@" ;;
    stop)               cmd_stop "$@" ;;
    search)             cmd_search "$@" ;;
    digest)             cmd_digest "$@" ;;
    preship)            cmd_preship "$@" ;;
    publish)            cmd_publish "$@" ;;
    statusline)         cmd_statusline "$@" ;;
    init)               cmd_init "$@" ;;
    status)             cmd_status "$@" ;;
    pause)              cmd_pause "$@" ;;
    resume)             cmd_resume "$@" ;;
    archive)            cmd_archive "$@" ;;
    curate)             cmd_curate "$@" ;;
    index)              cmd_index "$@" ;;
    library)            cmd_library "$@" ;;
    link)               cmd_link "$@" ;;
    unlink)             cmd_unlink "$@" ;;
    off)                cmd_off "$@" ;;
    config)             cmd_config "$@" ;;
    migrate)            cmd_migrate "$@" ;;
    remove-old-install) cmd_remove_old_install "$@" ;;
    doctor)             cmd_doctor "$@" ;;
    hook)               cmd_hook "$@" ;;
    version|-v|--version) plugin_version ;;
    help|-h|--help)     usage ;;
    __desktop_path)     __desktop_path "$@" ;;
    __sanitize)         __sanitize "$@" ;;
    *)
      echo "scribe: unknown command '$cmd'. Run 'scribe help' to see the commands." >&2
      exit 2
      ;;
  esac
}

main "$@"
