{
  "description": "Terminal Scribe: load the project journal when a session starts, and fill any gaps in it when a session ends.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/scribe\" hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/scribe\" hook session-end",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
