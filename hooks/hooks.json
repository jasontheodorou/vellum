{
  "description": "Vellum: load the project journal when a session starts, and start the curator to organise it when a session ends.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/vellum\" hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/vellum\" hook session-end"
          }
        ]
      }
    ]
  }
}
